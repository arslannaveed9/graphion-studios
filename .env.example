# Database
MONGODB_URI=mongodb://127.0.0.1:27017/graphion

# Auth — generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
AUTH_COOKIE_NAME=gs_session

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed admin (used by npm run seed)
ADMIN_NAME=Graphion Admin
ADMIN_EMAIL=admin@graphion.studio
ADMIN_PASSWORD=ChangeMeNow!2026

# Email (Resend preferred)
RESEND_API_KEY=
EMAIL_FROM=Graphion Studios <hello@graphion.studio>
ADMIN_NOTIFY_EMAIL=hello@graphion.studio

# Optional SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=graphion

# Optional search console / analytics (also editable in admin)
# GOOGLE_ANALYTICS_ID=
# GOOGLE_SITE_VERIFICATION=

# Preview drafts
PREVIEW_SECRET=replace-with-another-random-secret
